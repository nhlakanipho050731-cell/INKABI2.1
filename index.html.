  if(w!==null&&wf!==null){
    if(w>wf){score-=1;details.push("Wages above forecast: potentially hawkish.");}
    else if(w<wf){score+=1;details.push("Wages below forecast: potentially dovish.");}
  }
  let lean=score>=2?"POTENTIAL USD-NEGATIVE / GOLD-SUPPORTIVE":
    score<=-2?"POTENTIAL USD-SUPPORTIVE / GOLD-NEGATIVE":"MIXED / WAIT FOR CONFIRMATION";
  result.className="notice";
  result.textContent=lean+". "+details.join(" ")+" This is an initial heuristic, not a prediction. Verify revisions, units, DXY, nominal and real yields, spread, and price action. "+($("nfpNotes").value.trim()?"Notes: "+$("nfpNotes").value.trim():"");
