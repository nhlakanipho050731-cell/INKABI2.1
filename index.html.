function parsePricePayload(data) {
  var price = null, time = null;
  if (data && Array.isArray(data.symbols)) {
    var item = data.symbols.find(function(s) {
      return s && String(s.symbol || "").toUpperCase() === "XAU";
    }) || data.symbols[0];
    if (item) {
      price = Number(item.price);
      time = item.computed_at || item.updatedAt || item.timestamp || null;
      if (item.is_stale === true) throw new Error("Provider marks this quote stale.");
    }
  } else if (data && typeof data === "object") {
    price = Number(data.price || data.rate || data.last || data.ask);
    time = data.updatedAt || data.updated_at || data.timestamp ||
      data.computed_at || data.date || null;
    if (data.is_stale === true || data.stale === true) {
      throw new Error("Provider marks this quote stale.");
    }
  }
  if (!Number.isFinite(price) || price <= 0) {
    throw new Error("The API response did not contain a valid XAU price.");
  }
  var providerTime = null;
  if (typeof time === "number") {
    providerTime = time < 1e12 ? time * 1000 : time;
  } else if (time) {
    var parsed = Date.parse(time);
    if (Number.isFinite(parsed)) providerTime = parsed;
  }
  if (!providerTime) {
    throw new Error("No usable provider timestamp. Quote rejected.");
  }
  var age = (Date.now() - providerTime) / 1000;
  if (age < -300) throw new Error("Provider timestamp is unexpectedly in the future.");
  if (age > Number(state.maxQuoteAge || 180)) {
    throw new Error("Provider quote is stale (" + Math.floor(age) + " seconds old).");
  }
  return {price:price, providerTime:providerTime, receivedAt:Date.now()};
}
async function refreshGold() {
  if (requestInProgress) return;
  if (!navigator.onLine) {
    setDot("bad", "OFFLINE — MONITORING IMPAIRED");
    $("feedStatus").textContent = "OFFLINE";
    renderQuote();
    toast("Offline. No live quote can be verified.");
    return;
  }
  var url = String(state.apiUrl || "").trim();
  if (!url) {
    setDot("bad", "GOLD FEED NOT CONFIGURED");
    toast("Enter a gold API URL in Tests & Settings.");
    renderQuote();
    return;
  }
  try {
    var parsedUrl = new URL(url);
    if (parsedUrl.protocol !== "https:") {
      throw new Error("Use an HTTPS API URL.");
    }
  } catch (e) {
    setDot("bad", "INVALID FEED URL");
    toast(e.message || "Invalid API URL.");
    return;
  }
  requestInProgress = true;
  lastCheckMs = Date.now();
  $("feedStatus").textContent = "REQUEST IN PROGRESS";
  setDot("warn", "CHECKING GOLD FEED");
