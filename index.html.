/* Tests are run locally; no test is marked passed before execution. */
function addTest(name,passed,detail) {
  state.tests.push({name,passed,detail});
}
function runTests() {
  state.tests=[];
  addTest("Six screens exist",
    ["home","gold","macro","risk","calendar","tests"].every(id=>$(id)!==null),
    "Checks that all six screen containers exist.");
  addTest("Navigation buttons exist",
    document.querySelectorAll("#navigation button[data-screen]").length===6,
    "Checks for six navigation controls.");
  addTest("Risk limit calculation",
    Math.abs((1000*2/100)-20)<0.0001,
    "Checks the basic arithmetic: 2% of R1,000 equals R20.");
  addTest("Stale quote detection",
    (Date.now()-10000)<=Date.now() && Number($("staleSeconds").value)>=60,
    "Checks basic age-threshold inputs; does not simulate a provider outage.");
  addTest("Live feed retrieved",
    state.price!==null && isFresh() && !state.error,
    state.price===null ? "No quote retrieved." :
      state.error || "A recent retrieval exists; actual provider freshness is not independently verified.");
  addTest("Risk block calculation",
    (()=>{
      const r=state.risk;
      const loss=Number(r.loss)||0;
      const limit=(Number(r.balance)||0)*(Number(r.dailyPct)||0)/100;
      return (limit>0 && loss>=limit) ||
        (Number(r.maxEntries)||0)<=(Number(r.entries)||0) ||
        (Number(r.balance)||0)<=0;
    })()===riskNumbers().blocked,
    "Checks local advisory risk-block logic against current inputs.");
  renderTests();
}
