  $("clock").textContent = new Date().toLocaleTimeString();
  setInterval(function() {
    $("clock").textContent = new Date().toLocaleTimeString();
    renderQuote();
  }, 1000);
  startRefreshTimer();
  if (navigator.onLine) {
    refreshGold();
  } else {
    setDot("bad","OFFLINE — MONITORING IMPAIRED");
  }
  if (bootErrors.length) toast(bootErrors.join(" "));
}
try {
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded",boot,{once:true});
  } else {
    boot();
  }
} catch (e) {
  console.error("INKABI.21 startup error:",e);
  var status = document.getElementById("connectionText");
  if (status) status.textContent = "STARTUP ERROR — NAVIGATION MAY BE LIMITED";
}
})();
</script>
</body>
