function drawChart() {
  const canvas=$("priceChart");
  if (!canvas || !canvas.getContext) return;
  const ctx=canvas.getContext("2d");
  const w=canvas.width,h=canvas.height;
  ctx.clearRect(0,0,w,h);
  ctx.strokeStyle="#293140";ctx.lineWidth=1;
  for(let i=1;i<=4;i++){
    const y=i*h/5;ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(w,y);ctx.stroke();
  }
  const data=state.history.slice(-30);
  if(data.length<2){
    ctx.fillStyle="#939baa";ctx.font="15px sans-serif";
    ctx.fillText("Waiting for quote history",20,h/2);return;
  }
  const vals=data.map(d=>d.price);
  const min=Math.min(...vals),max=Math.max(...vals);
  const range=max-min || Math.max(max*0.001,1);
  ctx.strokeStyle="#d7b568";ctx.lineWidth=3;ctx.beginPath();
  data.forEach((d,i)=>{
    const x=10+i*(w-20)/(data.length-1);
    const y=h-15-((d.price-min)/range)*(h-35);
    if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);
  });
  ctx.stroke();
  ctx.fillStyle="#f0d69a";ctx.font="14px sans-serif";
  ctx.fillText("$"+priceFormat(max),10,16);
  ctx.fillText("$"+priceFormat(min),10,h-3);
}
