/* Risk journal: local advisory controls, not broker-side order blocking. */
function riskNumbers() {
  const r=state.risk;
  const balance=Math.max(0,Number(r.balance)||0);
  const dailyLimit=Math.max(0,Number(r.dailyPct)||0);
  const tradePct=Math.max(0,Number(r.riskPct)||0);
  const maxLoss=balance*dailyLimit/100;
  const tradeRisk=balance*tradePct/100;
  const loss=Math.max(0,Number(r.loss)||0);
  const remaining=Math.max(0,maxLoss-loss);
  const entriesLeft=Math.max(0,Math.floor(Number(r.maxEntries)||0)-Math.floor(Number(r.entries)||0));
  const blocked=balance<=0 || dailyLimit<=0 || tradePct<=0 ||
    loss>=maxLoss || entriesLeft<=0 || loss>maxLoss;
  return {balance,maxLoss,tradeRisk,loss,remaining,entriesLeft,blocked};
}
function updateRiskUI() {
  const n=riskNumbers();
  $("riskMaxLoss").textContent=money(n.maxLoss);
  $("riskRemaining").textContent=money(n.remaining);
  $("riskPerTrade").textContent=money(Math.min(n.tradeRisk,n.remaining));
  $("riskEntriesRemaining").textContent=n.entriesLeft;
  $("riskBar").style.width=(n.maxLoss>0?Math.min(100,n.loss/n.maxLoss*100):0)+"%";
  $("riskBar").style.background=n.blocked?"#ff6878":"#d7b568";
  $("riskBlockStatus").textContent=n.blocked?"NO-GO — LIMIT OR CONFIGURATION BLOCK":"MANUAL LIMITS NOT EXCEEDED";
  $("riskMessage").textContent=n.blocked?
    "Do not take a new trade under your configured rules. Verify inputs and broker records.":
    "Journal limits have not been exceeded. This does not establish that a trade is safe.";
  $("homeLoss").textContent=money(n.loss);
  $("homeLossBar").style.width=(n.maxLoss>0?Math.min(100,n.loss/n.maxLoss*100):0)+"%";
  $("homeLossText").textContent="Limit "+money(n.maxLoss)+" · "+n.entriesLeft+" entries remaining";
}
