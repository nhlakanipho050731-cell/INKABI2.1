function renderHistory() {
  const body=$("priceHistory");
  body.replaceChildren();
  if (!state.history.length) {
    const tr=document.createElement("tr"),td=document.createElement("td");
    td.colSpan=3;td.textContent="No quotes yet.";tr.append(td);body.append(tr);return;
  }
  state.history.slice().reverse().slice(0,12).forEach((item,index,array)=>{
    const tr=document.createElement("tr");
    const values=[
      localDate(item.time),
      "$"+priceFormat(item.price),
      index===array.length-1?"—":
        ((item.price-array[index+1].price)>=0?"+":"")+
        priceFormat(item.price-array[index+1].price)
    ];
    values.forEach(v=>{const td=document.createElement("td");td.textContent=v;tr.append(td);});
    body.append(tr);
  });
