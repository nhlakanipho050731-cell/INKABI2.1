$("assessNfp").addEventListener("click",()=>{
  const a=safeNumber($("nfpActual").value);
  const f=safeNumber($("nfpForecast").value);
  const u=safeNumber($("nfpUnemployment").value);
  const uf=safeNumber($("nfpUnemploymentForecast").value);
  const w=safeNumber($("nfpWages").value);
