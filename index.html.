    setDot("ok", "RECENT API RESPONSE — VERIFY SOURCE");
    renderQuote();
    toast("Quote received. Verify it against your broker chart.");
  } catch (e) {
    /* Keep last quote only for transparency; it is never treated as live. */
    setDot("bad", "FEED ERROR — MONITORING IMPAIRED");
    $("feedStatus").textContent = "ERROR: " +
      (e && e.message ? e.message : "Unknown error");
    renderQuote();
    toast("Feed failed: " + (e && e.message ? e.message : "unknown error"));
