
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#090b10">
<title>INKABI.21 — Gold Intelligence</title>
<style>
:root{
  --bg:#090b10;--panel:#11151d;--panel2:#171d27;
  --line:#293140;--gold:#d7b568;--gold2:#f0d69a;
  --text:#f2f3f5;--muted:#939baa;--green:#4bd4a0;
  --red:#ff6878;--yellow:#f5c66b;--blue:#83b9ff;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);
font:14px/1.5 system-ui,-apple-system,sans-serif}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
header{position:sticky;top:0;z-index:10;background:#090b10f2;
border-bottom:1px solid var(--line);padding:15px 16px}
.brand{font-weight:900;font-size:21px;letter-spacing:2px;color:var(--gold)}
.brand small{display:block;color:var(--muted);font-size:10px;
letter-spacing:2px;font-weight:500}
.headerline{display:flex;align-items:center;justify-content:space-between;gap:10px}
.status{font-size:10px;color:var(--yellow);border:1px solid #5b4b2d;
padding:5px 8px;border-radius:20px}
nav{display:flex;gap:7px;overflow-x:auto;padding:10px 12px;
background:var(--bg);border-bottom:1px solid var(--line);
scrollbar-width:thin}
nav button{flex-shrink:0;border:1px solid var(--line);border-radius:8px;
padding:9px 13px;background:var(--panel);color:var(--muted)}
nav button.active{background:#302719;border-color:var(--gold);color:var(--gold2)}
main{padding:16px;max-width:1000px;margin:auto;padding-bottom:40px}
.screen{display:none}
.screen.active{display:block}
h1{font-size:23px;margin:8px 0 3px}
h2{font-size:16px;margin:0 0 12px}
h3{font-size:13px;margin:0 0 8px;color:var(--gold2)}
p{color:var(--muted)}
.sub{color:var(--muted);font-size:12px}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}
.card{background:var(--panel);border:1px solid var(--line);
border-radius:13px;padding:14px;margin-bottom:11px;min-width:0}
.card.gold{border-color:#554729;background:linear-gradient(140deg,#211c12,#11151d 65%)}
.bigprice{font-size:clamp(25px,7vw,39px);font-weight:800;letter-spacing:-1px;
overflow-wrap:anywhere}
.metric{font-size:20px;font-weight:750}
.label{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.7px}
.goldtext{color:var(--gold2)}
.green{color:var(--green)}
.red{color:var(--red)}
.yellow{color:var(--yellow)}
.blue{color:var(--blue)}
.pill{display:inline-block;border:1px solid var(--line);border-radius:20px;
padding:4px 8px;font-size:10px;color:var(--muted)}
.row{display:flex;align-items:center;justify-content:space-between;gap:10px}
hr{border:0;border-top:1px solid var(--line);margin:13px 0}
button.primary,.btn{background:var(--gold);color:#16120a;border:0;
padding:10px 13px;border-radius:8px;font-weight:750}
button.secondary{background:var(--panel2);color:var(--text);
border:1px solid var(--line);padding:9px 12px;border-radius:8px}
button.danger{background:#32191e;color:#ffb7c0;border:1px solid #6d303b;
padding:9px 12px;border-radius:8px}
button:disabled{opacity:.45;cursor:not-allowed}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.field{display:flex;flex-direction:column;gap:5px;margin:10px 0}
.field label{font-size:12px;color:var(--muted)}
input,select,textarea{width:100%;min-width:0;background:#0b0e14;
color:var(--text);border:1px solid var(--line);border-radius:8px;
padding:10px;outline:none}
input:focus,select:focus,textarea:focus{border-color:var(--gold)}
textarea{min-height:70px;resize:vertical}
.notice{border:1px solid #514329;background:#211b10;color:#f1d99f;
padding:11px;border-radius:9px;font-size:12px;margin:10px 0}
.notice.error{border-color:#66313a;background:#251317;color:#ffb2bd}
.notice.ok{border-color:#235b49;background:#10251e;color:#9ce9cb}
.list{display:flex;flex-direction:column;gap:8px}
.item{padding:10px;border:1px solid var(--line);border-radius:9px;background:#0d1118}
.item strong{display:block;margin-bottom:3px}
.bar{height:7px;border-radius:5px;background:#292f39;overflow:hidden;margin:9px 0}
.bar span{display:block;height:100%;width:0;background:var(--gold)}
table{width:100%;border-collapse:collapse;font-size:12px}
th,td{text-align:left;padding:9px 6px;border-bottom:1px solid var(--line)}
th{color:var(--muted);font-weight:500}
footer{color:var(--muted);font-size:11px;text-align:center;padding:20px}
.smallbtn{font-size:11px;padding:6px 9px!important}
canvas{width:100%;height:180px;display:block}
@media(min-width:650px){
 main{padding:24px}
 .grid{grid-template-columns:repeat(3,minmax(0,1fr))}
 .grid3{grid-template-columns:repeat(3,minmax(0,1fr))}
}
@media(max-width:370px){
 main{padding:11px}
 .card{padding:11px}
 .grid3{grid-template-columns:repeat(2,minmax(0,1fr))}
}
</style>
</head>
<body>
<header>
  <div class="headerline">
    <div class="brand">INKABI.21<small>GOLD INTELLIGENCE SYSTEM</small></div>
    <span class="status" id="systemStatus">INITIALISING</span>
  </div>
</header>

<nav id="navigation" aria-label="Main navigation">
  <button class="active" data-screen="home">Home</button>
  <button data-screen="gold">Gold</button>
  <button data-screen="macro">Macro</button>
  <button data-screen="risk">Risk</button>
  <button data-screen="calendar">Calendar</button>
  <button data-screen="tests">Tests & Settings</button>
</nav>

<main>
<!-- HOME -->
<section class="screen active" id="home">
  <div class="row">
    <div>
      <div class="label">TRADING COMMAND CENTRE</div>
      <h1>Market overview</h1>
      <p class="sub" id="localTime">Waiting for clock…</p>
    </div>
    <span class="pill" id="dayStatus">ASSESSING</span>
  </div>

  <div id="homeWarning" class="notice error">
    Market feed has not yet been verified. Do not treat this dashboard as live until a current quote is confirmed.
  </div>

  <div class="grid">
    <div class="card gold">
      <div class="label">XAU/USD · USD per oz</div>
      <div class="bigprice" id="homePrice">—</div>
      <p class="sub" id="homeQuoteAge">No verified quote</p>
      <button class="secondary smallbtn" data-go="gold">Open Gold →</button>
    </div>
    <div class="card">
      <div class="label">Trade permission</div>
      <div class="metric yellow" id="homePermission">NO-GO</div>
      <p class="sub" id="homePermissionText">Waiting for verification checks.</p>
    </div>
    <div class="card">
      <div class="label">Macro assessment</div>
      <div class="metric" id="homeBias">NEUTRAL</div>
      <p class="sub">Manual inputs only until verified data sources are available.</p>
    </div>
    <div class="card">
      <div class="label">Daily loss used</div>
      <div class="metric" id="homeLoss">R0.00</div>
      <div class="bar"><span id="homeLossBar"></span></div>
      <p class="sub" id="homeLossText">Configure risk settings.</p>
    </div>
    <div class="card">
      <div class="label">Feed status</div>
      <div class="metric yellow" id="homeFeedStatus">UNKNOWN</div>
      <p class="sub" id="homeFeedMessage">Checking feed…</p>
    </div>
    <div class="card">
      <div class="label">Safety checks</div>
      <div class="metric" id="homeChecks">0 / 5</div>
      <p class="sub">Passed checks are not a trade signal.</p>
      <button class="secondary smallbtn" data-go="tests">Run diagnostics →</button>
    </div>
  </div>

  <div class="card">
    <h2>Today's decision checklist</h2>
    <div class="list" id="homeChecklist">
      <div class="item">Verify price feed freshness.</div>
      <div class="item">Check economic releases and event risk.</div>
      <div class="item">Confirm direction and market structure on your chart.</div>
      <div class="item">Check spread, stop distance and available risk.</div>
      <div class="item">Never enter solely because the dashboard says GO.</div>
    </div>
  </div>
</section>

<!-- GOLD -->
<section class="screen" id="gold">
  <div class="label">INSTRUMENT MONITOR</div>
  <h1>Gold intelligence</h1>
  <p class="sub">XAU/USD · Spot gold reference price in USD per troy ounce</p>

  <div id="goldWarning" class="notice error">No current quote has been verified.</div>
  <div class="card gold">
    <div class="row">
      <span class="label">Latest retrieved price</span>
      <span class="pill" id="goldSourceStatus">UNVERIFIED</span>
    </div>
    <div class="bigprice" id="goldPrice">—</div>
    <div class="row">
      <span class="sub" id="goldTimestamp">Last update: never</span>
      <span class="sub" id="goldAge">Age: unknown</span>
    </div>
    <hr>
    <div class="grid">
      <div><div class="label">Previous quote</div><div class="metric" id="goldPrevious">—</div></div>
      <div><div class="label">Change between quotes</div><div class="metric" id="goldChange">—</div></div>
    </div>
    <div class="actions">
      <button class="primary" id="refreshGold">Refresh quote</button>
      <button class="secondary" id="autoRefreshToggle">Auto-refresh: ON</button>
    </div>
    <p class="sub">Refresh interval: 60 seconds. The timestamp records retrieval time, not necessarily the provider's market timestamp.</p>
  </div>

  <div class="card">
    <h2>Feed integrity</h2>
    <div class="list">
      <div class="row"><span>Network available</span><strong id="networkState">Checking</strong></div>
      <div class="row"><span>Last successful retrieval</span><strong id="lastSuccess">Never</strong></div>
      <div class="row"><span>Quote freshness</span><strong id="freshnessState">UNKNOWN</strong></div>
      <div class="row"><span>Data source</span><strong id="sourceLabel">Gold API</strong></div>
    </div>
    <p class="sub">A successful HTTP response does not independently prove that the provider's quote is current or executable at your broker.</p>
  </div>

  <div class="card">
    <h2>Price observation</h2>
    <canvas id="priceChart" width="700" height="250" aria-label="Retrieved gold quote history"></canvas>
    <p class="sub" id="chartNote">The chart only records quotes retrieved by this page. It is not a broker tick chart.</p>
  </div>

  <div class="card">
    <h2>Price history</h2>
    <div style="overflow-x:auto">
      <table>
        <thead><tr><th>Retrieved (local)</th><th>Price</th><th>Change</th></tr></thead>
        <tbody id="priceHistory"><tr><td colspan="3">No quotes yet.</td></tr></tbody>
      </table>
    </div>
  </div>
</section>

<!-- MACRO -->
<section class="screen" id="macro">
  <div class="label">MACROECONOMIC MONITOR</div>
  <h1>Macro intelligence</h1>
  <p class="sub">Enter verified observations from reliable sources. Blank fields remain unknown, not zero.</p>

  <div class="notice">
    This version does not automatically retrieve DXY, Treasury yields, real yields, headlines or central-bank statements. Do not interpret missing data as confirmation.
  </div>

  <div class="card">
    <h2>Market observations</h2>
    <div class="field"><label for="dxy">DXY index level (optional)</label><input id="dxy" type="number" step="any" placeholder="Enter verified observation"></div>
    <div class="field"><label for="dxyDirection">DXY direction</label><select id="dxyDirection"><option value="unknown">Unknown</option><option value="up">Rising</option><option value="down">Falling</option><option value="flat">Sideways</option></select></div>
    <div class="field"><label for="yield10">US 10-year nominal yield (%)</label><input id="yield10" type="number" step="any" placeholder="Enter verified observation"></div>
    <div class="field"><label for="realYield">US 10-year real yield (%)</label><input id="realYield" type="number" step="any" placeholder="Enter verified observation"></div>
    <div class="field"><label for="yieldDirection">Yield direction</label><select id="yieldDirection"><option value="unknown">Unknown</option><option value="up">Rising</option><option value="down">Falling</option><option value="mixed">Mixed</option><option value="flat">Sideways</option></select></div>
    <div class="field"><label for="riskTone">Risk environment</label><select id="riskTone"><option value="unknown">Unknown</option><option value="riskoff">Risk-off / safe-haven demand</option><option value="riskon">Risk-on</option><option value="mixed">Mixed</option></select></div>
    <div class="field"><label for="macroTime">Observation time / source</label><input id="macroTime" placeholder="e.g. 10:30 SAST — source name"></div>
    <button class="primary" id="saveMacro">Save observations and assess</button>
  </div>

  <div class="card">
    <h2>Gold bias assessment</h2>
    <div class="metric" id="macroBias">INSUFFICIENT DATA</div>
    <p id="macroExplanation" class="sub">Enter verified observations to assess alignment.</p>
    <div class="bar"><span id="macroBar"></span></div>
    <div class="row"><span class="sub">Signal agreement</span><strong id="macroAgreement">Unknown</strong></div>
    <p class="sub">This is a simple directional heuristic, not a calibrated probability or a forecast. Gold can rise or fall against these relationships.</p>
  </div>

  <div class="card">
    <h2>Headline journal</h2>
    <div class="field"><label for="headline">Headline and source</label><textarea id="headline" placeholder="Paste the headline and source"></textarea></div>
    <div class="field"><label for="headlineImpact">Potential mechanism</label><select id="headlineImpact"><option value="unknown">Unassessed</option><option value="usd">USD strength / weakness</option><option value="rates">Interest rates / real yields</option><option value="inflation">Inflation expectations</option><option value="safehaven">Safe-haven demand</option><option value="liquidity">Liquidity / positioning</option></select></div>
    <button class="secondary" id="saveHeadline">Add to journal</button>
    <div class="list" id="headlineList" style="margin-top:12px"></div>
  </div>
</section>

<!-- RISK -->
<section class="screen" id="risk">
  <div class="label">CAPITAL PROTECTION</div>
  <h1>Risk management</h1>
  <div class="notice error">
    These browser controls cannot read MT5 account equity, detect broker executions or prevent an order being placed. Enter actual results manually.
  </div>

  <div class="card">
    <h2>Configure daily limits</h2>
    <div class="grid">
      <div class="field"><label for="accountSize">Reference account balance (R)</label><input id="accountSize" type="number" min="0" step="0.01" value="1000"></div>
      <div class="field"><label for="riskPercent">Risk limit per trade (%)</label><input id="riskPercent" type="number" min="0" max="100" step="0.1" value="1"></div>
      <div class="field"><label for="dailyLimit">Daily loss limit (%)</label><input id="dailyLimit" type="number" min="0" max="100" step="0.1" value="2"></div>
      <div class="field"><label for="maxEntries">Maximum entries per day</label><input id="maxEntries" type="number" min="1" max="100" step="1" value="3"></div>
    </div>
    <button class="primary" id="saveRisk">Save risk settings</button>
  </div>

  <div class="card">
    <h2>Today's manual journal</h2>
    <div class="grid">
      <div class="field"><label for="lossAmount">Net daily loss so far (R)</label><input id="lossAmount" type="number" min="0" step="0.01" value="0"></div>
      <div class="field"><label for="entryCount">Entries taken today</label><input id="entryCount" type="number" min="0" step="1" value="0"></div>
    </div>
    <button class="primary" id="updateJournal">Update journal</button>
    <hr>
    <div class="grid">
      <div><div class="label">Maximum daily loss</div><div class="metric" id="riskMaxLoss">R20.00</div></div>
      <div><div class="label">Remaining loss allowance</div><div class="metric" id="riskRemaining">R20.00</div></div>
      <div><div class="label">Suggested risk per trade</div><div class="metric" id="riskPerTrade">R10.00</div></div>
      <div><div class="label">Entries remaining</div><div class="metric" id="riskEntriesRemaining">3</div></div>
    </div>
    <div class="bar"><span id="riskBar"></span></div>
    <div class="metric red" id="riskBlockStatus">NO-GO — VERIFY INPUTS</div>
    <p class="sub" id="riskMessage">Configure and verify your risk settings.</p>
  </div>

  <div class="card">
    <h2>Session reset</h2>
    <p class="sub">Resetting the local journal does not change broker records or your account balance.</p>
    <button class="danger" id="resetRisk">Reset daily journal</button>
  </div>
</section>

<!-- CALENDAR -->
<section class="screen" id="calendar">
  <div class="label">EVENT RISK MANAGEMENT</div>
  <h1>Economic calendar</h1>
  <div class="notice">
    There is no verified automatic calendar connection in this version. Add scheduled events from a reliable economic calendar. Do not rely on an empty list as proof that no major release is due.
  </div>

  <div class="card">
    <h2>Add an event</h2>
    <div class="field"><label for="eventName">Event name</label><input id="eventName" placeholder="e.g. US CPI / NFP / FOMC"></div>
    <div class="grid">
      <div class="field"><label for="eventDate">Date</label><input id="eventDate" type="date"></div>
      <div class="field"><label for="eventTime">Time (your local time)</label><input id="eventTime" type="time"></div>
    </div>
    <div class="field"><label for="eventImpact">Impact</label><select id="eventImpact"><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option></select></div>
    <div class="field"><label for="eventSource">Source / notes</label><input id="eventSource" placeholder="Source and time zone"></div>
    <button class="primary" id="addEvent">Add event</button>
  </div>

  <div class="card">
    <h2>Upcoming events</h2>
    <div class="list" id="eventList"><p class="sub">No events entered. Calendar status is unverified.</p></div>
  </div>

  <div class="card">
    <h2>NFP reaction map</h2>
    <p class="sub">Enter the published actual and forecast figures after release. Compare like-for-like units and check revisions before interpreting.</p>
    <div class="field"><label for="nfpActual">Payrolls actual (thousands)</label><input id="nfpActual" type="number" step="any" placeholder="Actual"></div>
    <div class="field"><label for="nfpForecast">Payrolls forecast (thousands)</label><input id="nfpForecast" type="number" step="any" placeholder="Forecast"></div>
    <div class="field"><label for="nfpUnemployment">Unemployment actual (%)</label><input id="nfpUnemployment" type="number" step="any" placeholder="Actual"></div>
    <div class="field"><label for="nfpUnemploymentForecast">Unemployment forecast (%)</label><input id="nfpUnemploymentForecast" type="number" step="any" placeholder="Forecast"></div>
    <div class="field"><label for="nfpWages">Average hourly earnings actual (%)</label><input id="nfpWages" type="number" step="any" placeholder="Monthly or annual — specify in notes"></div>
    <div class="field"><label for="nfpWagesForecast">Average hourly earnings forecast (%)</label><input id="nfpWagesForecast" type="number" step="any" placeholder="Same measurement as actual"></div>
    <div class="field"><label for="nfpNotes">Revisions / notes / measurement</label><textarea id="nfpNotes" placeholder="Prior revisions, source, units, release time"></textarea></div>
    <button class="primary" id="assessNfp">Assess release</button>
    <div id="nfpResult" class="notice">Awaiting verified release figures.</div>
    <p class="sub">The initial reaction may reverse quickly. Check DXY, nominal and real yields, price structure, spread and follow-through before considering a trade.</p>
  </div>
</section>

<!-- TESTS & SETTINGS -->
<section class="screen" id="tests">
  <div class="label">SYSTEM RELIABILITY</div>
  <h1>Tests & settings</h1>
  <p class="sub">Diagnostics report what this browser can test. They do not prove broker connectivity or profitability.</p>

  <div class="card">
    <h2>System diagnostics</h2>
    <div class="actions">
      <button class="primary" id="runTests">Run tests</button>
      <button class="secondary" id="clearTestResults">Clear results</button>
    </div>
    <div id="testResults" class="list" style="margin-top:12px">
      <p class="sub">Tests have not been run.</p>
    </div>
  </div>

  <div class="card">
    <h2>Gold feed settings</h2>
    <div class="notice">
      A provider endpoint must support browser CORS access. Never paste private API keys or passwords into a public GitHub repository.
    </div>
    <div class="field">
      <label for="apiUrl">Gold price API URL</label>
      <input id="apiUrl" type="url" placeholder="https://api.gold-api.com/price/XAU">
    </div>
    <div class="field">
      <label for="refreshSeconds">Refresh interval (seconds; minimum 30)</label>
      <input id="refreshSeconds" type="number" min="30" max="3600" step="10" value="60">
    </div>
    <div class="field">
      <label for="staleSeconds">Mark quote stale after (seconds)</label>
      <input id="staleSeconds" type="number" min="60" max="3600" step="30" value="180">
    </div>
    <button class="primary" id="saveFeedSettings">Save and restart feed</button>
    <p class="sub">The default provider may be unavailable or may change its response format. A quote retrieved now is not proof of a real-time executable broker price.</p>
  </div>

  <div class="card">
    <h2>Data and privacy</h2>
    <p class="sub">Settings and journals are stored in this browser's local storage. Clearing browser data or changing browsers can erase them. No server-side backup is provided.</p>
    <div class="row"><span>Browser online</span><strong id="diagOnline">Unknown</strong></div>
    <div class="row"><span>JavaScript running</span><strong class="green">YES</strong></div>
    <div class="row"><span>MT5 connection</span><strong class="yellow">NOT CONNECTED</strong></div>
    <div class="row"><span>Automatic macro feed</span><strong class="yellow">NOT CONFIGURED</strong></div>
    <div class="row"><span>Automatic calendar feed</span><strong class="yellow">NOT CONFIGURED</strong></div>
    <hr>
    <button class="danger" id="clearLocalData">Clear INKABI.21 local data</button>
    <p class="sub">This permanently clears this browser's INKABI.21 settings, event journal, headlines and risk journal. It does not delete your GitHub files.</p>
  </div>
</section>

<footer>
  INKABI.21 · Decision support, not financial advice.<br>
  Verify prices, releases and risk on your broker and authoritative sources before trading.
</footer>
</main>

<script>
"use strict";

/* INKABI.21 — standalone browser application
   No external JavaScript libraries required. */

const $ = id => document.getElementById(id);
const STORE = "inkabi21_standalone_v1";
const state = {
  price: null,
  previousPrice: null,
  fetchedAt: null,
  providerTime: null,
  source: "",
  error: "",
  history: [],
  timer: null,
  autoRefresh: true,
  events: [],
  headlines: [],
  tests: [],
  macro: {bias:"NEUTRAL",agreement:"Unknown"},
  risk: {balance:1000,riskPct:1,dailyPct:2,maxEntries:3,loss:0,entries:0}
};

const defaultApi = "https://api.gold-api.com/price/XAU";
const defaults = {
  apiUrl: defaultApi,
  refreshSeconds: 60,
  staleSeconds: 180
};

function safeNumber(value) {
  if (value === "" || value === null || value === undefined) return null;
  const n = Number(value);
  return Number.isFinite(n) ? n : null;
}
function money(value) {
  return "R" + Number(value || 0).toLocaleString("en-ZA",{
    minimumFractionDigits:2,maximumFractionDigits:2
  });
}
function priceFormat(value) {
  return value === null || !Number.isFinite(value) ? "—" :
    value.toLocaleString("en-US",{minimumFractionDigits:2,maximumFractionDigits:2});
}
function localDate(timestamp) {
  return timestamp ? new Date(timestamp).toLocaleString() : "Never";
}
function readStore() {
  try {
    const raw = localStorage.getItem(STORE);
    if (!raw) return {};
    const parsed = JSON.parse(raw);
    return parsed && typeof parsed === "object" ? parsed : {};
  } catch (error) {
    console.warn("Local storage unavailable", error);
    return {};
  }
}
function persist() {
  try {
    const settings = {
