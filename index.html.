function restore() {
  const saved=readStore();
  const settings={...defaults,...(saved.settings||{})};
  $("apiUrl").value=settings.apiUrl;
  $("refreshSeconds").value=settings.refreshSeconds;
  $("staleSeconds").value=settings.staleSeconds;

  if(saved.risk && typeof saved.risk==="object") state.risk={...state.risk,...saved.risk};
  $("accountSize").value=state.risk.balance;
  $("riskPercent").value=state.risk.riskPct;
  $("dailyLimit").value=state.risk.dailyPct;
  $("maxEntries").value=state.risk.maxEntries;
  $("lossAmount").value=state.risk.loss;
  $("entryCount").value=state.risk.entries;

  state.events=Array.isArray(saved.events)?saved.events:[];
  state.headlines=Array.isArray(saved.headlines)?saved.headlines:[];
  state.history=Array.isArray(saved.history)?saved.history.filter(
    x=>x&&Number.isFinite(x.price)&&Number.isFinite(x.time)
  ).slice(-40):[];

  if(saved.macro){
    ["dxy","dxyDirection","yield10","realYield","yieldDirection","riskTone","macroTime"].forEach(id=>{
      if(saved.macro[id]!==undefined)$(id).value=saved.macro[id];
    });
  }
  renderEvents();renderHeadlines();assessMacro();updateRiskUI();
  $("localTime").textContent=new Date().toLocaleString();
  renderGold();runSafetySummary();
}
try {
  restore();
  setStatus(navigator.onLine?"STARTING":"OFFLINE");
  startRefreshTimer();
  fetchGold();
} catch(error) {
  console.error("INKABI.21 startup error:",error);
  setStatus("STARTUP ERROR");
  const warning=$("homeWarning");
  warning.textContent="Startup error: "+(error.message||"unknown error")+". Open Tests & Settings and report this message.";
  warning.className="notice error";
}
</script>
</body>
</html>
