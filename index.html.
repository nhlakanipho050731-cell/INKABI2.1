/* Macro assessment: simple directional heuristic, not a probability. */
function assessMacro() {
  const dd=$("dxyDirection").value;
  const yd=$("yieldDirection").value;
  const risk=$("riskTone").value;
  let points=0,known=0,parts=[];
  if(dd==="up"){points-=1;known++;parts.push("rising DXY can pressure gold");}
  if(dd==="down"){points+=1;known++;parts.push("falling DXY can support gold");}
  if(yd==="up"){points-=1;known++;parts.push("rising yields can pressure gold");}
  if(yd==="down"){points+=1;known++;parts.push("falling yields can support gold");}
  if(risk==="riskoff"){points+=1;known++;parts.push("safe-haven demand may support gold");}
  if(risk==="riskon"){points-=1;known++;parts.push("risk-on conditions may reduce safe-haven demand");}
  const bias=known===0?"INSUFFICIENT DATA":
    points>=2?"BULLISH LEAN":points<=-2?"BEARISH LEAN":"MIXED / NEUTRAL";
  state.macro={bias,agreement:known+" directional inputs"};
  $("macroBias").textContent=bias;
  $("macroExplanation").textContent=parts.length?parts.join("; ")+".":"No directional inputs available.";
  $("macroAgreement").textContent=known+" inputs; score "+points;
  $("macroBar").style.width=(known?Math.min(100,Math.abs(points)/known*100):0)+"%";
  $("homeBias").textContent=bias;
  $("homeBias").className="metric "+(bias.includes("BULLISH")?"green":bias.includes("BEARISH")?"red":"yellow");
  persist();
}
