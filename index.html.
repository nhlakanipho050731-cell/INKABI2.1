    result.className="notice error";
    result.textContent="Insufficient data: enter verified actual and forecast payroll figures.";
    return;
  }
  let score=0,details=[];
  if(a>f){score-=1;details.push("Payrolls beat forecast: potentially USD-supportive.");}
  else if(a<f){score+=1;details.push("Payrolls missed forecast: potentially USD-negative.");}
  else details.push("Payrolls matched forecast.");
  if(u!==null&&uf!==null){
