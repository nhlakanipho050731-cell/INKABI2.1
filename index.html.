
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#090b10">
<meta name="color-scheme" content="dark">
<title>INKABI.21 — Gold Intelligence</title>
<style>
:root {
  --bg:#090b10; --panel:#111620; --panel2:#171e2a;
  --line:#293343; --text:#f0f3f8; --muted:#9aa7b9;
  --gold:#e6bd65; --green:#62d6a0; --red:#ff7777;
  --blue:#83baff; --radius:16px;
}
* { box-sizing:border-box }
html { scroll-behavior:smooth }
body {
  margin:0; background:var(--bg); color:var(--text);
  font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
  font-size:14px; line-height:1.5;
}
button,input,select,textarea { font:inherit }
button { cursor:pointer }
button:focus-visible,input:focus-visible,select:focus-visible,
textarea:focus-visible { outline:2px solid var(--gold); outline-offset:2px }
header {
  position:sticky;top:0;z-index:10;
  background:rgba(9,11,16,.97);border-bottom:1px solid var(--line);
  padding:13px 16px;
}
.brand {display:flex;align-items:center;gap:11px}
.brand-mark {
  width:42px;height:42px;border:1px solid var(--gold);border-radius:12px;
  display:grid;place-items:center;color:var(--gold);font-weight:900;font-size:20px;
}
h1 {font-size:17px;letter-spacing:2px;margin:0}
.subtitle {font-size:11px;color:var(--muted);letter-spacing:1.3px}
.header-status {display:flex;align-items:center;gap:7px;margin-top:10px;color:var(--muted);font-size:11px}
.dot {width:8px;height:8px;border-radius:50%;background:#777;display:inline-block}
.dot.ok {background:var(--green)}
.dot.bad {background:var(--red)}
.dot.warn {background:var(--gold)}
nav {
  display:flex;gap:7px;overflow-x:auto;padding:10px 12px;
  border-bottom:1px solid var(--line);background:var(--bg);
  scrollbar-width:thin;
}
.nav-btn {
  flex:0 0 auto;border:1px solid var(--line);background:var(--panel);
  color:var(--muted);padding:9px 13px;border-radius:10px;font-weight:650;
}
.nav-btn.active {background:#302819;border-color:var(--gold);color:var(--gold)}
main {max-width:900px;margin:auto;padding:17px 14px 100px}
.screen {display:none}
.screen.active {display:block}
h2 {font-size:21px;margin:4px 0 5px}
h3 {font-size:14px;margin:0 0 12px}
p {margin:7px 0}
.muted {color:var(--muted)}
.small {font-size:11px}
.eyebrow {color:var(--gold);font-size:10px;letter-spacing:1.8px;font-weight:800}
.grid {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.grid.three {grid-template-columns:repeat(3,minmax(0,1fr))}
.card {
  min-width:0;background:var(--panel);border:1px solid var(--line);
  border-radius:var(--radius);padding:15px;margin:11px 0;
}
.grid .card {margin:0}
.metric {font-size:24px;font-weight:800;letter-spacing:-.6px;overflow-wrap:anywhere}
.metric.gold {color:var(--gold)}
.metric.green {color:var(--green)}
.metric.red {color:var(--red)}
.label {font-size:11px;color:var(--muted);margin-bottom:7px}
.badge {
  display:inline-flex;align-items:center;border:1px solid var(--line);
  border-radius:99px;padding:4px 9px;font-size:10px;font-weight:750;
}
.badge.ok {color:var(--green);border-color:#285c49}
.badge.warn {color:var(--gold);border-color:#69542d}
.badge.bad {color:var(--red);border-color:#713b3b}
button.primary,.primary {
  background:var(--gold);color:#15120b;border:1px solid var(--gold);
  font-weight:800;
}
.btn {
  padding:10px 13px;border:1px solid var(--line);border-radius:10px;
  background:var(--panel2);color:var(--text);font-weight:650;
}
.btn:disabled {opacity:.4;cursor:not-allowed}
.actions {display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
input,select,textarea {
  width:100%;background:#0b0f16;color:var(--text);
  border:1px solid var(--line);border-radius:9px;padding:11px;margin:5px 0 12px;
}
input[type=checkbox] {width:auto;margin:0 7px 0 0}
label {display:block;color:var(--muted);font-size:12px}
textarea {min-height:80px;resize:vertical}
hr {border:0;border-top:1px solid var(--line);margin:16px 0}
.row {display:flex;justify-content:space-between;align-items:center;gap:10px}
.row span:last-child {text-align:right}
.list {display:grid;gap:9px}
.list-item {padding:11px 0;border-bottom:1px solid var(--line)}
.list-item:last-child {border-bottom:0}
.notice {
  border:1px solid #62502c;background:#211d14;color:#e8d7ad;
  border-radius:12px;padding:12px;margin:12px 0;
}
.notice.danger {border-color:#713b3b;background:#241617;color:#ffb6b6}
.notice.info {border-color:#294865;background:#101c29;color:#b5d7ff}
.bar {height:7px;background:#252d3a;border-radius:99px;overflow:hidden;margin:10px 0}
.bar span {display:block;height:100%;background:var(--gold);width:0}
footer {border-top:1px solid var(--line);padding:18px;color:var(--muted);font-size:11px;text-align:center}
#toast {
  position:fixed;bottom:18px;left:14px;right:14px;z-index:30;
  padding:13px;background:#252d3a;border:1px solid var(--line);
  border-radius:12px;display:none;box-shadow:0 8px 30px #0009;
}
#toast.show {display:block}
.event-date {color:var(--gold);font-size:11px}
pre {white-space:pre-wrap;overflow-wrap:anywhere}
@media(max-width:420px) {
  .grid.three {grid-template-columns:repeat(2,minmax(0,1fr))}
  .metric {font-size:21px}
  main {padding-left:11px;padding-right:11px}
  .card {padding:12px}
}
@media(prefers-reduced-motion:reduce) {
  html {scroll-behavior:auto}
  * {animation:none!important;transition:none!important}
}
</style>
</head>
<body>
<header>
  <div class="brand">
    <div class="brand-mark">I.</div>
    <div>
      <h1>INKABI.21</h1>
      <div class="subtitle">GOLD INTELLIGENCE SYSTEM</div>
    </div>
  </div>
  <div class="header-status">
    <span id="connectionDot" class="dot warn"></span>
    <span id="connectionText">INITIALISING DIAGNOSTICS</span>
    <span style="margin-left:auto" id="clock">--:--:--</span>
  </div>
</header>

<nav id="navigation" aria-label="Main navigation">
  <button class="nav-btn active" data-screen="home">Home</button>
  <button class="nav-btn" data-screen="gold">Gold</button>
  <button class="nav-btn" data-screen="macro">Macro</button>
  <button class="nav-btn" data-screen="risk">Risk</button>
  <button class="nav-btn" data-screen="calendar">Calendar</button>
  <button class="nav-btn" data-screen="tests">Tests &amp; Settings</button>
</nav>

<main>
<section class="screen active" id="screen-home">
  <div class="eyebrow">DAILY COMMAND CENTRE</div>
  <h2>Gold trading intelligence</h2>
  <p class="muted">Observe first. Confirm second. Execute only within your rules.</p>

  <div class="notice" id="mainNotice">
    FEED NOT YET VERIFIED — no live-trading decision should depend on an unverified quote.
  </div>

  <div class="grid">
    <div class="card">
      <div class="label">XAU/USD REFERENCE PRICE</div>
      <div class="metric gold" id="homePrice">—</div>
      <div class="small muted" id="homeQuoteState">Awaiting a verified response</div>
    </div>
    <div class="card">
      <div class="label">DAY CLASSIFICATION</div>
      <div class="metric" style="font-size:20px" id="dayStatus">UNASSESSED</div>
      <div class="small muted" id="dayReason">Insufficient verified inputs</div>
    </div>
    <div class="card">
      <div class="label">RISK PERMISSION</div>
      <div class="metric" style="font-size:20px" id="homeRisk">CHECK REQUIRED</div>
      <div class="small muted" id="homeRiskReason">Configure your limits in Risk</div>
    </div>
    <div class="card">
      <div class="label">LAST FEED CHECK</div>
      <div class="metric" style="font-size:18px" id="lastCheck">Never</div>
      <div class="small muted" id="quoteAge">Quote age unknown</div>
    </div>
  </div>

  <div class="card">
    <h3>Today's operating rules</h3>
    <div class="list">
      <div class="row"><span>Quote freshness</span><span id="ruleFeed" class="badge warn">UNVERIFIED</span></div>
      <div class="row"><span>Macro agreement</span><span id="ruleMacro" class="badge warn">UNKNOWN</span></div>
      <div class="row"><span>Risk limit</span><span id="ruleRisk" class="badge warn">CHECK</span></div>
      <div class="row"><span>Economic event check</span><span id="ruleCalendar" class="badge warn">NOT VERIFIED</span></div>
    </div>
    <div class="actions">
      <button class="btn primary" data-go="gold">Check gold feed</button>
      <button class="btn" data-go="risk">Review risk</button>
      <button class="btn" data-go="tests">Run diagnostics</button>
    </div>
  </div>

  <div class="card">
    <h3>Trading permission logic</h3>
    <p class="muted">A favourable market view is not permission to trade. A setup must have fresh data, a confirmed price-action trigger, acceptable risk and a checked event calendar.</p>
    <div id="permissionText" class="notice info">NO TRADE PERMISSION: complete the checks before considering an entry.</div>
  </div>
</section>

<section class="screen" id="screen-gold">
  <div class="eyebrow">MARKET DATA</div>
  <h2>Gold monitor</h2>
  <p class="muted">The displayed price is only as reliable as its source and timestamp.</p>

  <div class="card">
    <div class="label">XAU/USD — API REPORTED PRICE</div>
    <div class="metric gold" id="goldPrice" style="font-size:38px">—</div>
    <div id="goldBadge" class="badge warn">NO VERIFIED QUOTE</div>
    <div class="list" style="margin-top:14px">
      <div class="row"><span class="muted">Provider timestamp</span><span id="providerTime">Unavailable</span></div>
      <div class="row"><span class="muted">Quote age</span><span id="goldAge">Unknown</span></div>
      <div class="row"><span class="muted">Last successful response</span><span id="successTime">Never</span></div>
      <div class="row"><span class="muted">Feed status</span><span id="feedStatus">Not checked</span></div>
    </div>
    <div class="actions">
      <button class="btn primary" id="refreshGold">Refresh gold</button>
      <button class="btn" id="clearQuote">Clear stored quote</button>
    </div>
  </div>

  <div class="notice danger">
    A previous price is not a live price. If the API fails, this app marks the quote unavailable and blocks its own trade-permission indicator.
  </div>

  <div class="card">
    <h3>Price-action levels</h3>
    <p class="muted small">Enter levels from your own chart. These values are not calculated from the feed.</p>
    <label for="support">Support level</label>
    <input id="support" type="number" step="any" placeholder="e.g. 4100.00">
    <label for="resistance">Resistance level</label>
    <input id="resistance" type="number" step="any" placeholder="e.g. 4200.00">
    <label for="trigger">Confirmed trigger / invalidation notes</label>
    <textarea id="trigger" placeholder="Break, retest, rejection, invalidation and timeframe..."></textarea>
    <button class="btn primary" id="saveLevels">Save chart notes</button>
  </div>

  <div class="card">
    <h3>Feed verification checklist</h3>
    <p class="muted">Before relying on a quote, compare it with your broker's XAU/USD chart. Spot gold feeds can differ from broker prices.</p>
    <div id="feedDiagnostic">No successful response verified yet.</div>
  </div>
</section>

<section class="screen" id="screen-macro">
  <div class="eyebrow">MACRO INTELLIGENCE</div>
  <h2>Drivers &amp; conflicts</h2>
  <p class="muted">Manually record verified readings and headlines. This screen does not pretend to have fetched macro data when it has not.</p>

  <div class="notice info">
    Typical framework, not a guaranteed prediction: a rising US dollar and rising real yields can pressure gold; falling dollar and falling real yields can support it. Risk events and positioning can override these relationships.
  </div>

  <div class="card">
    <h3>Market inputs</h3>
    <label for="dxy">DXY direction</label>
    <select id="dxy">
      <option value="unknown">Unknown / not checked</option>
      <option value="up">Rising</option>
      <option value="down">Falling</option>
      <option value="flat">Mixed / flat</option>
    </select>
    <label for="yields">US 10-year real yield direction</label>
    <select id="yields">
      <option value="unknown">Unknown / not checked</option>
      <option value="up">Rising</option>
      <option value="down">Falling</option>
      <option value="flat">Mixed / flat</option>
    </select>
    <label for="headline">Verified headline or release summary</label>
    <textarea id="headline" placeholder="Source, release time, actual vs forecast, and observed market reaction"></textarea>
    <label for="macroTime">Time these inputs were checked</label>
    <input id="macroTime" type="datetime-local">
    <button class="btn primary" id="saveMacro">Save macro inputs</button>
  </div>

  <div class="grid">
    <div class="card">
      <div class="label">DXY IMPLICATION</div>
      <div id="dxyImplication">Unknown</div>
    </div>
    <div class="card">
      <div class="label">REAL-YIELD IMPLICATION</div>
      <div id="yieldImplication">Unknown</div>
    </div>
  </div>

  <div class="card">
    <h3>Combined assessment</h3>
    <div id="macroResult" class="badge warn">INSUFFICIENT DATA</div>
    <p id="macroExplanation" class="muted">Enter verified inputs before assessing alignment.</p>
    <p class="small muted">This is a simplified directional framework, not an AI forecast or a live market feed.</p>
  </div>
</section>

<section class="screen" id="screen-risk">
  <div class="eyebrow">CAPITAL PROTECTION</div>
  <h2>Risk control</h2>
  <p class="muted">These are local planning controls. They do not connect to MT5 or prevent orders at your broker.</p>

  <div class="notice danger" id="riskBanner">Risk controls have not yet been configured.</div>

  <div class="grid">
    <div class="card">
      <div class="label">DAILY LOSS USED</div>
      <div class="metric red" id="lossDisplay">R0.00</div>
      <div class="small muted" id="lossPercent">0% of configured limit</div>
      <div class="bar"><span id="lossBar"></span></div>
    </div>
    <div class="card">
      <div class="label">ENTRIES RECORDED</div>
      <div class="metric" id="entryDisplay">0</div>
      <div class="small muted" id="entryLimitDisplay">Configured entry limit required</div>
    </div>
  </div>

  <div class="card">
    <h3>Configure your limits</h3>
    <label for="dailyLimit">Maximum daily loss in rand (R)</label>
    <input id="dailyLimit" type="number" min="1" step="0.01" placeholder="e.g. 200">
    <label for="maxEntries">Maximum entries per day</label>
    <input id="maxEntries" type="number" min="1" max="100" step="1" placeholder="e.g. 3">
    <label for="riskPercent">Planned risk per trade (% of account)</label>
    <input id="riskPercent" type="number" min="0.01" max="100" step="0.01" placeholder="e.g. 1">
    <button class="btn primary" id="saveRisk">Save risk limits</button>
  </div>

  <div class="card">
    <h3>Record trading activity</h3>
    <label for="lossInput">Additional realised daily loss in rand (R)</label>
    <input id="lossInput" type="number" min="0" step="0.01" placeholder="0.00">
    <button class="btn" id="addLoss">Record loss</button>
    <hr>
    <p class="muted small">Record a new entry only after you have actually taken one. Avoid recording the same loss or entry twice.</p>
    <button class="btn" id="addEntry">Record one entry</button>
    <button class="btn" id="resetRisk">Reset daily counters</button>
    <p class="small muted">Resetting changes local records only. It cannot reset broker records or erase losses already incurred.</p>
  </div>
</section>

<section class="screen" id="screen-calendar">
  <div class="eyebrow">EVENT PREPARATION</div>
  <h2>Economic calendar</h2>
  <p class="muted">No calendar API is connected by default. Add events from a trusted calendar and verify times in South African Standard Time (SAST).</p>

  <div class="notice">
    Around high-impact releases, spreads and volatility can expand. Do not assume the first move is the final direction. Wait for the release, price reaction and your own confirmation rules.
  </div>

  <div class="card">
    <h3>Add an event</h3>
    <label for="eventName">Event name</label>
    <input id="eventName" placeholder="e.g. US CPI">
    <label for="eventTime">Event date and time</label>
    <input id="eventTime" type="datetime-local">
    <label for="eventImpact">Impact</label>
    <select id="eventImpact">
      <option value="high">High</option>
      <option value="medium">Medium</option>
      <option value="low">Low</option>
    </select>
    <label for="eventSource">Source / link / notes</label>
    <input id="eventSource" placeholder="Official release or calendar source">
    <button class="btn primary" id="addEvent">Add event</button>
  </div>

  <div class="card">
    <div class="row">
      <h3 style="margin:0">Your event list</h3>
      <button class="btn" id="clearEvents">Clear list</button>
    </div>
    <div id="eventList" class="list" style="margin-top:12px">No events added.</div>
  </div>
  <p class="small muted">This is a user-maintained list, not a complete or automatically updated economic calendar.</p>
</section>

<section class="screen" id="screen-tests">
  <div class="eyebrow">RELIABILITY LAB</div>
  <h2>Tests &amp; settings</h2>
  <p class="muted">Run simulated checks for known failure modes. A simulated pass does not prove that the live service is reliable.</p>

  <div class="card">
    <h3>Automatic diagnostics</h3>
    <div id="diagnostics" class="list">Diagnostics are initialising.</div>
    <div class="actions">
      <button class="btn primary" id="runTests">Run failure tests</button>
      <button class="btn" id="clearTestResults">Clear results</button>
    </div>
    <div id="testResults" class="list" style="margin-top:12px"></div>
  </div>

  <div class="card">
    <h3>Gold data feed</h3>
    <p class="muted small">The default endpoint is an unverified third-party option. Availability, CORS access, response format, accuracy and any usage restrictions must be tested on your phone.</p>
    <label for="apiUrl">Gold API URL</label>
    <input id="apiUrl" type="url" placeholder="https://api.gold-api.com/price/XAU">
    <label for="refreshSeconds">Refresh interval in seconds (minimum 30)</label>
    <input id="refreshSeconds" type="number" min="30" max="3600" step="1" value="60">
    <label for="maxQuoteAge">Maximum quote age in seconds</label>
    <input id="maxQuoteAge" type="number" min="30" max="3600" step="1" value="180">
    <button class="btn primary" id="saveSettings">Save settings</button>
    <button class="btn" id="resetSettings">Restore defaults</button>
    <p class="small muted">The browser cannot bypass a provider's CORS policy. If the provider blocks browser requests, use a compatible public endpoint or a properly configured server-side proxy.</p>
  </div>

  <div class="card">
    <h3>App status and data</h3>
    <div class="list">
      <div class="row"><span class="muted">Browser storage</span><span id="storageStatus">Checking</span></div>
      <div class="row"><span class="muted">Network</span><span id="networkStatus">Checking</span></div>
      <div class="row"><span class="muted">JavaScript</span><span class="badge ok">RUNNING</span></div>
    </div>
    <hr>
    <button class="btn" id="exportData">Export local data</button>
    <button class="btn" id="clearAllData">Clear all local app data</button>
    <p class="small muted">Export your data before clearing it. Clearing data removes saved settings, notes, events and local risk records.</p>
  </div>

  <div class="card">
    <h3>Known limitations</h3>
    <ul class="muted">
      <li>No broker or MT5 connection.</li>
      <li>No guaranteed live macro or news feed.</li>
      <li>No automatic order execution or broker-side risk lock.</li>
      <li>Local browser storage may be cleared by the device or browser.</li>
      <li>A price quote is not a trade signal.</li>
    </ul>
  </div>
</section>

<footer>
  INKABI.21 · GOLD INTELLIGENCE<br>
  Decision support only. Protect capital. Verify every source.
</footer>
</main>

<div id="toast" role="status" aria-live="polite"></div>

<script>
(function () {
"use strict";

/* Fail safely: keep the visible HTML usable even if an operation fails. */
var $ = function(id) { return document.getElementById(id); };
var defaults = {
  apiUrl: "https://api.gold-api.com/price/XAU",
  refreshSeconds: 60,
  maxQuoteAge: 180,
  dailyLimit: 0,
  maxEntries: 0,
  riskPercent: 1,
  loss: 0,
  entries: 0,
  riskDate: "",
  support: "",
  resistance: "",
  trigger: "",
  dxy: "unknown",
  yields: "unknown",
  headline: "",
  macroTime: "",
  events: []
};
var state = {};
var quote = null;
var lastCheckMs = 0;
var refreshTimer = null;
var toastTimer = null;
var requestInProgress = false;
var lastMacroAssessment = null;
var bootErrors = [];

function safeGet(key) {
  try { return localStorage.getItem(key); }
  catch (e) { return null; }
}
function safeSet(key, value) {
  try {
    localStorage.setItem(key, value);
    return true;
  } catch (e) {
    return false;
  }
}
function safeRemove(key) {
  try { localStorage.removeItem(key); } catch (e) {}
}
function readState() {
  var saved = safeGet("inkabi21_state");
  try {
    state = Object.assign({}, defaults, saved ? JSON.parse(saved) : {});
  } catch (e) {
    state = Object.assign({}, defaults);
    bootErrors.push("Saved settings could not be read.");
  }
  if (!Array.isArray(state.events)) state.events = [];
  if (!Number.isFinite(Number(state.loss))) state.loss = 0;
  if (!Number.isFinite(Number(state.entries))) state.entries = 0;
}
function saveState() {
  var ok = safeSet("inkabi21_state", JSON.stringify(state));
  if (!ok) toast("Storage unavailable. Changes may not survive a refresh.");
  updateStorageStatus();
  return ok;
}
function toast(message) {
  var node = $("toast");
  if (!node) return;
  node.textContent = message;
  node.classList.add("show");
  if (toastTimer) clearTimeout(toastTimer);
  toastTimer = setTimeout(function(){node.classList.remove("show");}, 3200);
}
function fmtTime(ms) {
  if (!ms || !Number.isFinite(ms)) return "Never";
  try { return new Date(ms).toLocaleString(); }
  catch (e) { return "Unavailable"; }
}
function fmtPrice(n) {
  return Number(n).toLocaleString(undefined, {
    minimumFractionDigits:2, maximumFractionDigits:4
  });
}
function fmtMoney(n) {
  return "R" + Number(n || 0).toLocaleString("en-ZA", {
    minimumFractionDigits:2, maximumFractionDigits:2
  });
}
function setBadge(id, text, type) {
  var node = $(id);
  if (!node) return;
  node.textContent = text;
  node.className = "badge " + (type || "warn");
}
function setDot(type, text) {
  $("connectionDot").className = "dot " + (type || "warn");
  $("connectionText").textContent = text;
}
function navigate(name) {
  var target = $("screen-" + name);
  if (!target) return;
  document.querySelectorAll(".screen").forEach(function(el) {
    el.classList.toggle("active", el.id === "screen-" + name);
  });
  document.querySelectorAll(".nav-btn").forEach(function(el) {
    el.classList.toggle("active", el.getAttribute("data-screen") === name);
    el.setAttribute("aria-current",
