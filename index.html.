/* Flexible response parsing, without treating invalid values as live quotes. */
function extractPrice(data) {
  const candidates = [];
  function add(v) {
    if (typeof v === "number" || (typeof v === "string" && v.trim()!=="")) {
      const n = Number(v);
      if (Number.isFinite(n) && n > 0) candidates.push(n);
    }
  }
  if (data && typeof data==="object") {
    add(data.price);
    add(data.rate);
    add(data.ask);
    add(data.close);
    if (data.data && typeof data.data==="object") {
      add(data.data.price);
      add(data.data.rate);
      add(data.data.ask);
    }
    if (Array.isArray(data.symbols)) {
      const xau = data.symbols.find(item =>
        item && String(item.symbol||"").toUpperCase()==="XAU");
      if (xau) add(xau.price);
    }
  }
  return candidates.length ? candidates[0] : null;
}
function extractProviderTime(data) {
  if (!data || typeof data!=="object") return null;
  const value = data.computed_at || data.timestamp || data.updated_at ||
    data.last_updated || data.date;
  if (!value) return null;
  const ms = typeof value==="number" ? value*(value<1e12?1000:1) : Date.parse(value);
  return Number.isFinite(ms) ? ms : null;
}
async function fetchGold() {
  const url = ($("apiUrl").value||defaultApi).trim();
  if (!url) {
    state.error = "No API URL configured.";
    renderGold();
    return false;
  }
  if (!navigator.onLine) {
    state.error = "Device reports no internet connection.";
    renderGold();
    return false;
  }
  $("refreshGold").disabled = true;
  $("refreshGold").textContent = "Refreshing…";
  const controller = new AbortController();
  const timeout = setTimeout(()=>controller.abort(),10000);
  try {
    const response = await fetch(url,{
      method:"GET",
      cache:"no-store",
      signal:controller.signal,
      headers:{"Accept":"application/json"}
    });
    if (!response.ok) throw new Error("Provider HTTP status "+response.status);
    const data = await response.json();
    const value = extractPrice(data);
    if (value===null) throw new Error("No recognised positive price in response.");
    const previous = state.price;
    state.previousPrice = previous;
    state.price = value;
    state.fetchedAt = Date.now();
    state.providerTime = extractProviderTime(data);
    state.source = url;
    state.error = "";
    state.history.push({price:value,time:state.fetchedAt});
    state.history = state.history.slice(-40);
    persist();
    renderGold();
    runSafetySummary();
    return true;
  } catch (error) {
    state.error = error.name==="AbortError" ? "Feed request timed out." :
      (error.message || "Feed request failed. Check URL, connection and CORS.");
    renderGold();
    runSafetySummary();
    return false;
  } finally {
    clearTimeout(timeout);
    $("refreshGold").disabled = false;
    $("refreshGold").textContent = "Refresh quote";
  }
}
